rules_version = '2';

// ── הבית הצהוב — חוקי אבטחת Firebase Storage ────────────────────────────────
// עד עכשיו (2026-07-11) חוקי ה-Storage מעולם לא נבדקו/לא נכתבו במפורש — ר'
// docs/PROJECT_CONTEXT.md סעיף 12. קיים סיכון שהבאקט עדיין ב-"test mode" עם
// כלל פתוח שפג/יפוג תוקף (בדיוק כמו שקרה ל-Firestore ב-2026-07-10).
// זהו ההידוק הראשון, במקביל ל-firestore.rules הקיים ובאותה פילוסופיה בדיוק.
//
// ⚠️ הערה חשובה שלא נפתרת ע"י הקובץ הזה: כל כתובת תמונה באתר מגיעה מ-
// getDownloadURL(), שמטביעה טוקן גישה בתוך ה-URL עצמו (?alt=media&token=...).
// מי שמחזיק את הכתובת המדויקת יכול לצפות בקובץ ללא קשר לחוקים כאן — זו
// התנהגות מובנית של Firebase Storage, לא באג. החוקים כאן חוסמים גישה לכל מי
// שאין לו את הכתובת (ניחוש נתיב, list גורף, כתיבה/מחיקה זדונית) — בדיוק כמו
// שהתקלה ב-Firestore הייתה "כל אחד עם קישור יכול לקרוא/לכתוב הכל".

service firebase.storage {
  match /b/{bucket}/o {

    // ── HELPERS ────────────────────────────────────────────────────────────
    // firestore.get()/firestore.exists() — פונקציונליות cross-service, בודקת
    // מסמכי Firestore ישירות מתוך חוקי Storage (אותו database, "(default)").

    function isAdmin() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/members/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/members/$(request.auth.uid)).data.isAdmin == true;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function underSizeLimit() {
      return request.resource.size < 15 * 1024 * 1024; // 15MB — תמונות טלפון גדולות, בלי לאפשר קבצים ענקיים
    }

    // ── תמונות עסק: לוגו / תמונה מייצגת / גלריה (businesses/{bizId}/...) ────
    // כתיבה: business.html (הרשמה, אנונימי, מסמך pending טרי) /
    //        business-dashboard.html (בעל עסק מחובר, auth.uid==bizId) /
    //        admin-businesses.html (מנהל)
    match /businesses/{bizId}/{fileName} {

      // קריאה: מנהל, בעל העסק עצמו, או כל אחד (כולל אנונימי) רק אם העסק
      // כבר approved — תואם בדיוק לכלל ה-get המקביל ב-firestore.rules
      // (עסקים מאושרים = ציבוריים בכוונה, כדי שיוצגו ב-home.html/welcome.html).
      allow read: if isAdmin()
        || (request.auth != null && request.auth.uid == bizId)
        || firestore.get(/databases/(default)/documents/businesses/$(bizId)).data.status == 'approved';

      allow write: if isImage() && underSizeLimit() && (
        isAdmin()
        || (request.auth != null && request.auth.uid == bizId)
        // אורח בהרשמה ראשונית — בלי session, אך רק לתוך עסק שכבר נוצר כ-pending
        // (business.html יוצר קודם את מסמך ה-Firestore, ורק אז מעלה תמונות)
        || (
          request.auth == null &&
          firestore.exists(/databases/(default)/documents/businesses/$(bizId)) &&
          firestore.get(/databases/(default)/documents/businesses/$(bizId)).data.status == 'pending'
        )
      );
    }

    // ── תמונת הוכחת אוהד (members/proofs/{memberId}_...) ────────────────────
    // כתיבה: fan-register.html/business.html (הרשמה, אנונימי) /
    //        admin-members.html (מנהל עורך)
    // קריאה: מוצגת אך ורק ב-admin-members.html — אבל ר' §293 למטה: **גם המעלה עצמו
    // חייב get**, אחרת getDownloadURL נכשל מיד אחרי העלאה מוצלחת.
    match /members/proofs/{fileName} {

      // ── §293: `read` פוצל ל-`get` ול-`list`, ו-`get` נפתח ─────────────────────────────────
      // **זה היה שורש `storage/unauthorized` לאורך ארבעה סבבים.** `getDownloadURL()` הוא
      // פעולת **קריאה**, והיא רצה מיד אחרי `uploadBytes()` באותה פונקציה. ההעלאה הצליחה
      // תמיד — הקובץ נמצא ב-bucket בכל אחד מאירועי-הכשל — ורק הקריאה שאחריה נדחתה, כי
      // נרשם אינו מנהל. ה-SDK החזיר `storage/unauthorized`, שנשמע כמו כשל-העלאה ואינו כזה.
      //
      // **מה מגן על התמונות עכשיו:** שם הקובץ. `fan-register.html` מעלה ל-
      // `members/proofs/{memberId}_{uuid}` — הסיומת אקראית ובלתי-ניתנת-לניחוש. זה בדיוק
      // מודל-האבטחה של כתובות ההורדה של Firebase עצמן (`?alt=media&token=…`), שכבר היום
      // ציבוריות לכל מי שמחזיק בקישור — כלומר אין כאן ויתור אמיתי, יש התאמה של החוק למציאות.
      //
      // ⚠️ למה **לא** מספיק להסתמך על כך שמזהה החבר אינו ידוע: `ownerMemberId` יושב על
      // מסמך עסק, ומסמך של עסק מאושר נקרא **ציבורית במלואו** (ר' §244). כלומר שם-קובץ
      // שנגזר ממזהה החבר בלבד (הפורמט הישן, `{memberId}_fan`) היה חשוף לכל בעלי-העסקים.
      // הסיומת האקראית היא מה שסוגר את זה — ולכן היא חלק מהחוק, לא פרט-מימוש.
      //
      // `list` נשאר למנהל בלבד: בלעדיו אפשר היה פשוט למנות את כל התיקייה ולעקוף את
      // האקראיות. **בלי השורה הזאת ה-get הפתוח היה חור אמיתי.**
      allow get: if true;
      allow list: if isAdmin();

      // ── §288: תנאי-ההרשאה הוסר — הוא היה **הסיבה** ל-storage/unauthorized ──────────────────
      // הניסוח הקודם היה `isAdmin() || request.auth == null`, כלומר: מותר למנהל, ומותר
      // לאורח לגמרי-לא-מחובר — ו**אסור לכל מי שביניהם**. מי נופל שם? כל חבר שכבר התחבר
      // פעם לאתר: הכניסה עושה signInWithCustomToken (welcome.html/profile.html), הסשן
      // נשמר ב-IndexedDB של הדומיין, ו-firebase-config.js מאתחל getAuth() בכל דף —
      // כולל טופס ההרשמה. ה-SDK מצרף את הטוקן להעלאה, request.auth כבר לא null,
      // והכתיבה נדחית. **דטרמיניסטי, בכל מכשיר ובכל גודל תמונה.**
      //
      // נמדד בפועל (§288): 3 אירועי formError עם `storage/unauthorized` — גם ממובייל וגם
      // מדסקטופ — בזמן שהעלאה אנונימית דרך REST לאותו נתיב בדיוק החזירה 200. ההבדל היחיד
      // בין שתי הבקשות היה הטוקן.
      //
      // למה בטוח להסיר: הנתיב הזה **כבר** פתוח לכתיבה אנונימית — זו הזרימה המתוכננת (אורח
      // שנרשם). הוספת "גם מחובר" לא מרחיבה את החשיפה ולו במעט; היא רק מפסיקה להעניש
      // דווקא את מי שכן התחבר. ההגנה האמיתית כאן היא `allow read: if isAdmin()` למעלה —
      // ההוכחות נשארות קריאות למנהל בלבד. isImage()+underSizeLimit() נשמרים כמו שהם.
      allow write: if isImage() && underSizeLimit();
    }

    // ── תמונות-קוביה בתוכן דף הנחיתה (landing/tiles/{fileName}) — שלב 6 ──────
    // כתיבה: admin-dashboard.html בלבד (מנהל, uploadFile ב-landingContentTabHtml).
    // קריאה ציבורית בכוונה — גם אם welcome.html עדיין לא קורא מזה בפועל (ר' PROJECT_CONTEXT.md §108),
    // כשזה ישולב בעתיד התמונות כבר צריכות להיות נגישות לכל מבקר, כמו כל שאר תמונות האתר.
    match /landing/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isImage() && underSizeLimit();
    }

    // ── תמונות "עסק השבוע · הטבת השבוע" (weeklySchedule/{scheduleId}/{fileName}) ────────────
    // כתיבה: admin-dashboard.html בלבד (מנהל, uploadFile ב-saveWeeklySchedule). אותו דפוס בדיוק
    // כמו landing/ — קריאה ציבורית בכוונה, כדי שהבאנר יוכל להיות מוצג ב-home.html בעתיד (הצגה
    // עצמה עדיין לא נבנתה, ר' docs/PROJECT_CONTEXT.md §93/§143 — אבל אין סיבה לחסום עכשיו ולהידרש
    // לשנות rules שוב כשזה ייבנה).
    match /weeklySchedule/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isImage() && underSizeLimit();
    }

    // ברירת מחדל: הכול חסום. אין match לאף נתיב אחר.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
