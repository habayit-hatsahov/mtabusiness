rules_version = '2';

// ── הבית הצהוב — חוקי אבטחת Firestore ──────────────────────────────────────
// עד 2026-07-11 החוקים היו פתוחים לגמרי (קריאה+כתיבה בלי אימות), כתיקון חירום
// זמני אחרי שהחוקים הקודמים פגו תוקף (ר' docs/PROJECT_CONTEXT.md סעיף 12).
// זהו ההידוק הראשון האמיתי, אחרי שנבנתה תשתית Auth מלאה (Worker מנפיק
// Firebase custom tokens לחברים/עסקים/מנהלים, כל דפי החברים+הניהול בודקים
// session אמיתי). ר' docs/PROJECT_CONTEXT.md למפת הגישה המלאה שהובילה לכתיבת
// הקובץ הזה, ולתיעוד הפשרות המפורשות שהתקבלו.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── HELPERS ──────────────────────────────────────────────────────────
    // Worker (worker/src/firestore.js, service-account OAuth) עוקף את כל
    // החוקים האלה לגמרי — לא מושפע מהקובץ הזה בשום צורה.

    // "אני מנהל?" — get() על מסמך *אחר* (members/{request.auth.uid}), לא
    // רקורסיה עצמית על המסמך הנוכחי שה-rule מריץ עליו. תבנית סטנדרטית
    // ובטוחה (Firestore data-driven lookup pattern).
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/members/$(request.auth.uid)).data.isAdmin == true;
    }

    // "אני חבר מחובר כלשהו?" (לא בהכרח מנהל) — משמש להיתר הכתיבה הצר על
    // likedBy/clicks בכל עסק (home.html). לא בודקים status=='approved':
    // הגעה ל-request.auth.uid שמפנה למסמך חבר קיים כבר מרמזת על אישור
    // (ה-Worker לא מנפיק custom token אלא לחברים עם status=='approved',
    // ר' worker/src/index.js handleMemberLogin) — חוסך get() מיותר.
    function isSignedInMember() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    // "אני עסק מחובר (role: business_owner) שמקושר ל-memberId הזה?" —
    // מאפשר ל-profile.html?bizToken= לקרוא את המסמך של בעל העסק שלו בלבד.
    function isLinkedBusinessOwnerOf(memberId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/businesses/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/businesses/$(request.auth.uid)).data.ownerMemberId == memberId;
    }

    // "אני החבר שמקושר לעסק הזה?" — בעל-עסק שמחובר כ*חבר* (home/terms/profile,
    // request.auth.uid = memberId) ומבקש את הטוקן של העסק שלו בלבד. הכיוון ההפוך
    // מ-isLinkedBusinessOwnerOf שמעל: שם עסק-מחובר קורא מסמך-חבר, כאן חבר-מחובר
    // קורא את הטוקן של העסק שלו.
    function isOwnerMemberOf(businessId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/businesses/$(businessId)) &&
        get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerMemberId == request.auth.uid;
    }

    // ── MEMBERS ──────────────────────────────────────────────────────────
    match /members/{memberId} {

      // מנהל: הכול. חבר מחובר: רק המסמך של עצמו. בעל עסק מחובר: רק אם הוא
      // מקושר (ownerMemberId) למסמך החבר הזה.
      allow get: if isAdmin()
        || (request.auth != null && request.auth.uid == memberId)
        || isLinkedBusinessOwnerOf(memberId);

      // אין list פומבי בכלל — דדופ עבר לגמרי ל-Worker (/check-member-exists).
      allow list: if isAdmin();

      // אורח (fan-register.html/business.html): מותר ליצור רשומת "pending"
      // חדשה, אך חובה status=='pending' וחובה שלא ייכתב isAdmin בכלל.
      allow create: if isAdmin()
        || (
          request.resource.data.status == 'pending' &&
          !('isAdmin' in request.resource.data)
        );

      allow update: if isAdmin()

        // (א) דדופ אנונימי לרשומה קיימת — אחרי שה-Worker כבר זיהה memberId
        // תואם. עדיין ללא request.auth — מוגבל בקפדנות לשדות "פרופיל אישי".
        || (
          request.auth == null &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'firstName', 'lastName', 'birthDate', 'phone', 'email',
              'isSubscriber', 'subscriberSection', 'subscriberNumber',
              'wasSubscriber', 'facebookUrl',
              // §284 — מסלולי-אימות. verifyMethod/verifyTrust מתארים *איך* אומת, ו-seat*
              // /verifyNote הם התוכן של שני מסלולים שאין להם קובץ. בלי הרשימה הזאת עדכון
              // דדופ אנונימי היה נדחה כולו (hasOnly = כל-או-כלום), כלומר הרשמה חוזרת של
              // אוהד קיים הייתה נכשלת בשקט.
              'verifyMethod', 'verifyTrust', 'seatBlock', 'seatRow', 'seatNumber', 'verifyNote',
              'isBusinessOwner', 'linkedBusinessId', 'photoProofUrl',
              'reviewFlag', 'reviewFlagAt', 'submittedAt', 'nameConflict'
            ]) &&
          // status: מותר להישאר זהה, או לרדת ל-'pending' בלבד (למשל אי-התאמת שם
          // בהרשמה כפולה) — לעולם לא לעלות ל-'approved' מנתיב לא-מאומת.
          (request.resource.data.status == resource.data.status ||
           request.resource.data.status == 'pending') &&
          (!('isAdmin' in resource.data) || request.resource.data.isAdmin == resource.data.isAdmin) &&
          // הגנה נוספת (אירוע אמיתי 2026-07-24: הרשמה עם טלפון של חבר אמיתי
          // דרסה את השם/מייל שלו עצמו) — כשנכתב nameConflict, השדות האישיים
          // של הרשומה הקיימת חייבים להישאר בדיוק כמו שהיו, בלי יוצא מן הכלל.
          (!('nameConflict' in request.resource.data) ||
            (request.resource.data.firstName == resource.data.firstName &&
             request.resource.data.lastName  == resource.data.lastName &&
             request.resource.data.email     == resource.data.email &&
             request.resource.data.phone     == resource.data.phone))
        )

        // (ב) חבר מחובר עורך את המסמך של עצמו — home.html/profile.html.
        // pushSubscriptions: מיפוי מכשיר→מנוי, נכתב מ-home.html כשחבר מאשר הרשאת Web Push (ר' §51/52) —
        // מיפוי (לא שדה בודד) כדי שמחשב+טלפון לא ידרסו זה את זה.
        || (
          request.auth != null && request.auth.uid == memberId &&
          request.resource.data.diff(resource.data).affectedKeys()
            // lastSeenAt נוסף כאן כתשתית לשלב 7 (שכבת מדידה) — אין עדיין קוד שכותב אליו בפועל
            .hasOnly(['phone', 'email', 'birthDate', 'pushSubscriptions', 'lastSeenAt']) &&
          request.resource.data.status == resource.data.status &&
          (!('isAdmin' in resource.data) || request.resource.data.isAdmin == resource.data.isAdmin)
        )

        // (ג) בעל-עסק מחובר מעדכן את **תאריך הלידה בלבד** על רשומת החבר המקושרת אליו
        // (2026-08-24). למה בכלל צריך ענף נפרד: בדשבורד העסק ה-uid הוא businessId ולא memberId,
        // ולכן ענף (ב) לא חל עליו. תאריך הלידה נשמר על רשומת החבר ולא על מסמך העסק, כי מסמך של
        // עסק מאושר נקרא **ציבורית במלואו** (ר' §244) ותאריך לידה הוא מידע אישי.
        // מכוון בקפדנות לשדה אחד: אין כאן דלת לעריכת שם/טלפון/מייל של החבר מצד העסק.
        || (
          isLinkedBusinessOwnerOf(memberId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['birthDate']) &&
          request.resource.data.status == resource.data.status &&
          (!('isAdmin' in resource.data) || request.resource.data.isAdmin == resource.data.isAdmin)
        );

      allow delete: if isAdmin();

      // יומן פעילות של החבר — תת-אוסף, נוסף רק (נכתב מ-logActivity() ב-admin-dashboard.html).
      // רק מנהל קורא/כותב — לא בעל-הרשומה עצמו, אין ל-members/profile.html צורך לראות את היומן.
      match /activity/{activityId} {
        allow read, create: if isAdmin();
        allow update, delete: if false;
      }
    }

    // ── BUSINESSES ───────────────────────────────────────────────────────
    match /businesses/{businessId} {

      // מנהל, בעל העסק עצמו, או כל אחד (כולל אנונימי) רק אם המסמך עצמו
      // כבר approved — עסקים מאושרים אמורים להיות ציבוריים; ממתינים/נדחים
      // מכילים טלפון/מייל של הבעלים ונשארים מוגנים.
      //
      // ⚠️ קריטי (2026-08-23, §244): המסמך המאושר נקרא **במלואו** ע"י כל אחד, בלי
      // אימות בכלל — Firestore לא יודע לסנן שדות ברמת ה-rule. לכן **אסור** להחזיר
      // לכאן שום סוד. accessToken (טוקן-הכניסה לדשבורד העסק) ישב כאן עד היום, מה
      // שאיפשר לכל אדם לשלוף אותו ב-curl אנונימי ולהיכנס לדשבורד של כל עסק ולערוך
      // אותו. הוא הועבר ל-bizTokens/{businessId} בתחתית הקובץ. כל שדה-סוד עתידי
      // (טוקן/קוד/מפתח) חייב לשבת שם ולא כאן.
      allow get: if isAdmin()
        || (request.auth != null && request.auth.uid == businessId)
        || resource.data.status == 'approved';

      // שאילתה ציבורית עם where('status','==','approved') בלבד — Firestore
      // אוכף את זה ברמת ה-query (שאילתה בלי הפילטר הזה תיכשל כולה).
      allow list: if isAdmin() || resource.data.status == 'approved';

      // אורח יוצר בקשת עסק חדשה: חובה status=='pending'.
      allow create: if isAdmin()
        || request.resource.data.status == 'pending';

      allow update: if isAdmin()

        // (א) יצירה אנונימית ממשיכה עם updateDoc מיידי: הוספת ownerMemberId,
        // ואח"כ עדכון תמונות אחרי Storage upload. status חייב להישאר pending.
        || (
          request.auth == null &&
          resource.data.status == 'pending' &&
          request.resource.data.status == 'pending' &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['ownerMemberId', 'photoProofUrl', 'logo', 'coverPhoto', 'photos'])
        )

        // (ב) בעל עסק מחובר עורך את pendingChanges של עצמו בלבד —
        // business-dashboard.html. לעולם לא כותב לשדות "החיים" ישירות. בכוונה בלי תלות ב-status:
        // accessToken מונפק גם לעסק pending (לא רק approved בפועל, בניגוד להערה הישנה כאן) —
        // עסק שממתין לאישור-ראשוני חייב להיות מסוגל להעלות/לערוך תמונות ופרטים לפני שמנהל בכלל
        // רואה את הבקשה, לא רק אחרי. תוקן 2026-08-13 אחרי דיווח-אמת: "Missing or insufficient
        // permissions" בפועל לעסק pending אמיתי שניסה לשלוח תמונה מהדשבורד.
        || (
          request.auth != null && request.auth.uid == businessId &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['pendingChanges', 'pendingChangesAt'])
        )

        // (ב2) בעל עסק מחובר כותב לנו הודעה מהדשבורד ("כתבו לנו", §234 — כרטיס #writeUsCard),
        // מאשר צפייה בהודעה שהמנהל סימן "טופלה" (noteOwnerAckAt), או שהיא מתנקה אוטומטית אצלו
        // כמה ימים אחרי (note/noteHandled/noteHandledAt/noteOwnerAckAt) — ר' business-dashboard.html
        // renderContactNoteBanner. פעולה עצמית על הודעה שהוא עצמו כתב, לא דורשת אישור מנהל
        // כמו pendingChanges רגיל.
        // noteAt (§235) — חותמת-זמן ההודעה, כדי שהמנהל יראה מתי בדיוק נכתבה ולא רק מה נכתב.
        || (
          request.auth != null && request.auth.uid == businessId &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['note', 'noteAt', 'noteHandled', 'noteHandledAt', 'noteOwnerAckAt'])
        )

        // (ב3) בעל עסק מחובר מאשר תנאי-הצטרפות מהדשבורד (2026-08-05) — ל-50 העסקים הישנים
        // שהצטרפו לפני שהצ'קבוקס הזה היה קיים בטופס ההרשמה. אישור חד-פעמי, לא ניתן לביטול
        // (רק דורש שעדיין לא אושר — resource.data לא מכיל agreedTermsAt).
        || (
          request.auth != null && request.auth.uid == businessId &&
          !('agreedTermsAt' in resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['agreedTermsAt'])
        )

        // (ב4) מיגרציית שעות הפעילות (2026-08-20, §230) — בעל עסק מחובר מסמן שראה את הקובייה
        // ושטיפל בה. חותמות-מעקב בלבד, לא תוכן שמוצג ללקוח: תוכן השעות עצמו
        // (hoursMode/hoursDays/hoursOther/hours) ממשיך לעבור דרך pendingChanges כמו כל שדה אחר.
        // hoursNoticeFirstSeen הוא write-once — חלון ההצגה נספר ממנו, ואיפוס שלו היה מאריך
        // אותו לנצח. hoursMigrationBy מוגבל ל-'owner' כדי שלא ייכתב מכאן "המנהל טיפל".
        || (
          request.auth != null && request.auth.uid == businessId &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['hoursNoticeFirstSeen', 'hoursMigrationDone', 'hoursMigrationBy']) &&
          (!('hoursNoticeFirstSeen' in resource.data) ||
            request.resource.data.hoursNoticeFirstSeen == resource.data.hoursNoticeFirstSeen) &&
          (!('hoursMigrationBy' in request.resource.data) ||
            request.resource.data.hoursMigrationBy == 'owner')
        )

        // (ג) כל חבר מחובר — likedBy/clicks בלבד, על כל עסק (home.html).
        || (
          isSignedInMember() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['likedBy', 'clicks'])
        );

      allow delete: if isAdmin();

      // יומן פעילות של העסק — אותו דפוס בדיוק כמו members/{memberId}/activity למעלה.
      match /activity/{activityId} {
        allow read, create: if isAdmin();
        allow update, delete: if false;
      }

      // אגרגציה יומית לעסק (שלב 7, §3 במפרט — "businesses/{bizId}/statsDaily/{date}") — יסודות
      // בלבד: אין עדיין שום קוד שכותב לכאן. בפועל ייכתב ע"י ה-Worker (service-account, עוקף
      // rules) בשלב האגרגציה העתידי — admin-בלבד ברמת ה-rules כדי שמרכז-הנתונים יוכל לקרוא ישירות.
      match /statsDaily/{dateId} {
        allow read, write: if isAdmin();
      }
    }

    // ── BIZTOKENS — טוקן הכניסה לדשבורד העסק (2026-08-23, §244) ──────────
    // מסמך אחד לכל עסק, מזהה-המסמך = businessId, שדה יחיד accessToken.
    // הופרד מ-businesses/{id} בדיוק בגלל ה-get/list הציבורי שמעל: הטוקן הוא
    // *אישור-כניסה* מלא לדשבורד (ה-Worker מנפיק מולו Firebase custom token עם
    // uid=businessId), ומסמך עסק מאושר קריא לכולם.
    //
    // מי קורא: (1) מנהל — מרכז הניהול בונה איתו לינקים והודעות; (2) העסק המחובר
    // עצמו; (3) החבר המקושר — "העסק שלי" ב-home/terms/profile.
    // ה-Worker (service-account) עוקף את החוקים האלה לגמרי, כרגיל.
    // ── MEMBER_CODES (§248, 2026-08-24) ──────────────────────────────────
    // קוד הכניסה של חבר ישב עד היום על members/{id}. הבעיה: Firestore קורא מסמך
    // **בשלמותו** ואי אפשר להסתיר שדה בודד — ו-members מותר בקריאה גם ל-
    // isLinkedBusinessOwnerOf, כלומר **זהות-העסק קראה את קוד הכניסה האישי של
    // הבעלים**. משמעות מעשית: בעל עסק ששולח את לינק הדשבורד שלו לעובד/גרפיקאי
    // מוסר איתו את הכניסה לחשבון האוהד שלו — וקוד חבר הוא קבוע, אין לו רוטציה
    // ואי אפשר לקחת אותו בחזרה. אומת חי מול session אמיתי של עסק (2026-08-24).
    //
    // ⚠️ אין כאן isLinkedBusinessOwnerOf, וזו כל הנקודה. לא להוסיף.
    // אותו דפוס בדיוק כמו bizTokens למטה (§244) — כל שדה-סוד יושב באוסף משלו.
    match /memberCodes/{memberId} {
      // החבר עצמו רשאי לקרוא את הקוד שלו (הסוד שלו). אין דף שעושה את זה היום,
      // אבל זו ההרשאה הנכונה והיא לא מוסיפה שום חשיפה.
      allow get: if isAdmin() || (request.auth != null && request.auth.uid == memberId);
      // list = שליפת כל הקודים. מנהל בלבד — נדרש גם לבדיקת-ייחודיות ב-generateLoginCode.
      allow list: if isAdmin();
      // הקוד מונפק רק באישור חבר, כלומר תמיד ע"י מנהל. ה-Worker כותב עם
      // service-account ולכן לא עובר דרך החוקים האלה בכלל.
      allow create, update, delete: if isAdmin();
    }

    match /bizTokens/{businessId} {
      allow get: if isAdmin()
        || (request.auth != null && request.auth.uid == businessId)
        || isOwnerMemberOf(businessId);

      // אין list לאף אחד חוץ ממנהל — list על האוסף הזה = שליפת כל הטוקנים.
      allow list: if isAdmin();

      // הרשמת עסק חדש (business.html) היא אנונימית, ולכן גם יצירת הטוקן שלה.
      // שלוש הגנות מצטברות:
      // (1) create חל רק כשהמסמך *לא* קיים — אי-אפשר לדרוס טוקן של עסק שכבר יש לו אחד;
      // (2) מזהה-המסמך חייב להיות של עסק **קיים** שסטטוסו 'pending' — כלומר גם אם מישהו
      //     ינחש מזהה, הוא לא יכול להנפיק טוקן לעסק מאושר (ולכולם ממילא כבר יש מסמך טוקן);
      // (3) שדה יחיד ותו לא.
      // עדכון/מחיקה (רוטציית טוקן) — מנהל בלבד.
      allow create: if isAdmin()
        || (
          request.auth == null &&
          request.resource.data.keys().hasOnly(['accessToken']) &&
          exists(/databases/$(database)/documents/businesses/$(businessId)) &&
          get(/databases/$(database)/documents/businesses/$(businessId)).data.status == 'pending'
        );
      allow update, delete: if isAdmin();
    }

    // ── WEEKLY_INTEREST (business.html §145 — "עסק השבוע · הטבת השבוע") ───
    // אין כאן match בכלל עד עכשיו (2026-08-04) — משמעות: גם הכתיבה האנונימית מ-business.html
    // וגם הקריאה של תור-הניהול ב-admin-dashboard.html נחסמו כברירת-מחדל ("הכול חסום" בתחתית
    // הקובץ). נתפס כי תור-הניהול ב-admin-dashboard.html קיבל permission-denied בבדיקה חיה —
    // הכתיבה המקורית מ-business.html מעולם לא נבדקה בפועל מול Firestore אמיתי (רק staging
    // מקומי, ר' docs/PROJECT_CONTEXT.md §145), אז הפער לא נתפס קודם.
    match /weekly_interest/{docId} {
      allow read, list: if isAdmin();

      // אורח יוצר רשומת-עניין חדשה מיד אחרי הרשמת עסק — בלי auth (עדיין אין accessToken באותו רגע).
      // חובה כל השדות בדיוק בערכי ברירת המחדל שהקוד כותב בפועל (business.html), כדי שלא ייכתב
      // תור מזויף/משובש; לפחות אחד מ-2 הדגלים חייב להיות true (אחרת אין סיבה לרשומה בכלל).
      allow create: if isAdmin()
        || (
          request.resource.data.keys().hasOnly([
            'businessId', 'wantsBusinessOfWeek', 'wantsBenefitOfWeek', 'requestedAt',
            'contactStatus', 'scheduledWeek', 'scheduledTrack', 'contentStatus'
          ]) &&
          request.resource.data.keys().hasAll([
            'businessId', 'wantsBusinessOfWeek', 'wantsBenefitOfWeek', 'requestedAt',
            'contactStatus', 'scheduledWeek', 'scheduledTrack', 'contentStatus'
          ]) &&
          request.resource.data.businessId is string &&
          request.resource.data.wantsBusinessOfWeek is bool &&
          request.resource.data.wantsBenefitOfWeek is bool &&
          (request.resource.data.wantsBusinessOfWeek || request.resource.data.wantsBenefitOfWeek) &&
          request.resource.data.requestedAt == request.time &&
          request.resource.data.contactStatus == 'pending' &&
          request.resource.data.scheduledWeek == null &&
          request.resource.data.scheduledTrack == null &&
          request.resource.data.contentStatus == 'missing'
        );

      // מנהל בלבד מעדכן (admin-dashboard.html — טאב "עסק השבוע": סטטוס פנייה/הוצאה-מהרשימה).
      allow update: if isAdmin();
      allow delete: if isAdmin();

      match /activity/{activityId} {
        allow read, create: if isAdmin();
        allow update, delete: if false;
      }
    }

    // ── WEEKLY_SCHEDULE (admin-dashboard.html — טאב "עסק השבוע") ────────────────────────────
    // כתיבה/עריכה — מנהל בלבד, אין אף כתיבה ציבורית/אנונימית. תמונות מועלות דרך Storage
    // (uploadFile), ה-URL נשמר כאן כמחרוזת. קריאה — גם בעל העסק המשובץ עצמו (business-dashboard.html
    // renderWeeklyCard, §146 סבב רביעי): תצוגת-סטטוס בלבד ("התור שלכם: DATE–DATE"), לא עריכה —
    // לכן read/list, לא write.
    match /weekly_schedule/{docId} {
      allow read, list: if isAdmin() || (request.auth != null && resource.data.businessId == request.auth.uid);
      allow write: if isAdmin();

      match /activity/{activityId} {
        allow read, create: if isAdmin();
        allow update, delete: if false;
      }
    }

    // ── COUNTERS (רק counters/members בשימוש בפועל) ──────────────────────
    match /counters/{counterId} {
      allow read, write: if isAdmin();
    }

    // ── SETTINGS (רק settings/messageTemplates בשימוש בפועל) ─────────────
    // תבניות המייל האוטומטיות שהאדמין עורך ב-admin-messages.html. ה-Worker
    // קורא את אותו מסמך עם ה-service-account שלו (עוקף את החוק הזה לגמרי,
    // ר' ההערה למעלה) כשהוא שולח את המיילים האוטומטיים בפועל.
    match /settings/{docId} {
      allow read, write: if isAdmin();

      // יומן פעילות למסמכי settings (למשל landingContent — שלב 6) — אותו דפוס בדיוק כמו
      // members/{memberId}/activity ו-businesses/{bizId}/activity: נוסף בלבד, מנהל בלבד.
      match /activity/{activityId} {
        allow read, create: if isAdmin();
        allow update, delete: if false;
      }
    }

    // settings/siteTexts — טקסטים ציבוריים (תקנון לאוהדים/עסקים) שמוצגים
    // ב-terms.html לכל מבקר באתר, לא רק למנהל — לכן קריאה פתוחה לכולם,
    // בעוד עריכה נשארת מוגבלת למנהל בלבד (admin-messages.html).
    match /settings/siteTexts {
      allow read: if true;
      allow write: if isAdmin();
    }

    // settings/sectionAnchors — עיגוני סלוטים ידניים לסקשנים/קטגוריות בעמוד הבית (home.html) —
    // אותו דפוס בדיוק כמו siteTexts: קריאה ציבורית (home.html קורא לכל מבקר), כתיבה מנהל בלבד
    // (admin-dashboard.html). ר' docs/PROJECT_CONTEXT.md לתיעוד הסכימה.
    match /settings/sectionAnchors {
      allow read: if true;
      allow write: if isAdmin();
    }

    // settings/tagTaxonomy — קטלוג התגיות האפשריות לכל קטגוריה (rename/delete/merge בניהול תגיות,
    // admin-dashboard.html). אותו דפוס: קריאה ציבורית, כתיבה מנהל בלבד. הערה: business.html/
    // business-dashboard.html/admin-businesses.html עדיין לא קוראים ממנו — נשארו על הקטלוג הקשיח שלהם.
    match /settings/tagTaxonomy {
      allow read: if true;
      allow write: if isAdmin();
    }

    // settings/landingContent — תוכן דף-הנחיתה (welcome.html, שלב 6) שמוצג לכל מבקר/אורח,
    // לא רק למנהל — בלי החוק הזה, welcome.html (שרץ בלי auth בשביל אורחים) נופל תמיד ל-
    // permission-denied על ה-match /settings/{docId} הכללי למעלה (admin-only) ונשאר על ברירת-
    // המחדל הקבועה ב-HTML לנצח, גם אחרי שהמנהל מפרסם שינוי אמיתי (באג-אמת שנתפס 2026-08-03,
    // ר' docs/PROJECT_CONTEXT.md — היה מתועד בעבר כ"לא-מאובחן"). אותו דפוס בדיוק כמו siteTexts/
    // sectionAnchors/tagTaxonomy: קריאה ציבורית, כתיבה מנהל בלבד.
    match /settings/landingContent {
      allow read: if true;
      allow write: if isAdmin();
    }

    // messageBroadcasts — היסטוריית שידורי מייל למרכז ההודעות (admin-dashboard.html).
    // נכתב מהקליינט אחרי שהוורקר (/send-broadcast-email) כבר שלח בפועל — מנהל בלבד, אין קריאה ציבורית.
    match /messageBroadcasts/{broadcastId} {
      allow read, write: if isAdmin();
    }

    // ── שכבת מדידה (שלב 7, §3 במפרט — "מרכז נתונים") — יסודות בלבד ────────
    // 2026-08-02: אין עדיין אף כותב אמיתי (לא דף חי, לא Worker) — המשתמש ביקש במפורש
    // "רק היסודות עכשיו", בלי לגעת בדפים חיים. events הוא משטח-הכתיבה הפומבי הראשון
    // בפרויקט שגם גולש לא-מחובר לגמרי (welcome.html, לפני הרשמה) יצטרך לכתוב אליו בעתיד —
    // ולכן מאומת בקפדנות שדה-שדה, לא רק "כל אחד יכול לכתוב". אין קריאה פומבית בכלל.
    match /events/{eventId} {
      allow read: if isAdmin();
      allow update, delete: if false;

      allow create: if
        request.resource.data.keys().hasOnly([
          'type', 'bizId', 'memberId', 'sessionId', 'path', 'referrer', 'device', 'blockId', 'channel', 'createdAt'
        ]) &&
        request.resource.data.keys().hasAll(['type', 'sessionId', 'device', 'createdAt']) &&
        request.resource.data.type in [
          'pageView', 'bizImpression', 'bizClick', 'bizContact', 'heart',
          'gateBlock', 'landingBlockClick', 'formOpen', 'formSubmit',
          // §284 — ניסיון-הרשמה שנכשל בפועל (לא נטישה). channel נושא את קוד-השגיאה האמיתי
          // ('permission-denied' / 'unavailable' / 'offline' / ...), וזה מה שמבדיל בין באג
          // אצלנו לבין תקלת-רשת אצל הנרשם. מוצג במרכז הניהול תחת "תקלות הרשמה".
          'formError',
          // ── §304 — התקדמות בטופס, לא נטישה ─────────────────────────────────────────────
          // 72% פותחים את טופס האוהד ולא שולחים, **בלי אף אירוע כשל** — כלומר היום אין לנו
          // מושג אם הם התחרטו או נתקעו, ואיפה. `formStep` נורה פעם אחת לכל אבן-דרך שנחצתה
          // (channel = 'identity' | 'subscriber' | 'route' | 'proof'), ומכאן אפשר לגזור
          // משפך: כמה הגיעו לכל שלב מול כמה שלחו בסוף.
          // ⚠️ **בכוונה לא נמדד ב-unload** — כתיבה בזמן סגירת-דף אינה אמינה, ובדיוק אצל מי
          // שסוגר מהר (הנוטש) היא תיכשל הכי הרבה. מדידה מתקדמת תוך כדי היא הדרך היחידה
          // שנתונים על נוטשים באמת מגיעים.
          'formStep',
          // §275 — מדידת מימוש-הטבה. channel נושא את הפעולה עצמה:
          // cardOpen | couponReveal | couponCopy | siteClick | contactWhatsapp | contactPhone
          'benefitRedeem',
          // ── §322 — ניסיון כניסה שנכשל ──────────────────────────────────────────────────
          // עד היום אוהד שלא הצליח להיכנס היה **בלתי-נראה לחלוטין**: אין אירוע, אין מונה,
          // אין שום מקום שבו זה מופיע. הכשל נראה במדידה כ"כניסה שלא קרתה" ולא כתקלה, ולכן
          // §322 (await חוסם שהשאיר אוהדים בחוץ) שרד בלי שאיש ידע. channel נושא את הסיבה:
          // badCode | pending | rejected | tooManyAttempts | timeout | moduleTimeout | error
          // ⚠️ `timeout`/`moduleTimeout` הם היחידים שמעידים על באג אצלנו ולא על טעות של
          // האוהד — ולכן הם חייבים להיות ערך נפרד ולא להתמזג ל"שגיאה".
          'loginFail'
        ] &&
        request.resource.data.device in ['mobile', 'desktop'] &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.sessionId is string && request.resource.data.sessionId.size() <= 100 &&
        (!('bizId' in request.resource.data) || request.resource.data.bizId == null ||
          (request.resource.data.bizId is string && request.resource.data.bizId.size() <= 100)) &&
        (!('memberId' in request.resource.data) || request.resource.data.memberId == null ||
          (request.resource.data.memberId is string && request.resource.data.memberId.size() <= 100)) &&
        (!('path' in request.resource.data) || request.resource.data.path == null ||
          (request.resource.data.path is string && request.resource.data.path.size() <= 200)) &&
        (!('referrer' in request.resource.data) || request.resource.data.referrer == null ||
          (request.resource.data.referrer is string && request.resource.data.referrer.size() <= 50)) &&
        (!('blockId' in request.resource.data) || request.resource.data.blockId == null ||
          (request.resource.data.blockId is string && request.resource.data.blockId.size() <= 50)) &&
        (!('channel' in request.resource.data) || request.resource.data.channel == null ||
          (request.resource.data.channel is string && request.resource.data.channel.size() <= 50));
    }

    // ── §303 — בקשות עזרה מטופס ההרשמה ("נתקעתי / משהו לא עובד") ─────────────────────────
    // אוהד שלא מצליח להירשם הוא היום **בלתי-נראה לגמרי**: אין רשומה, אין אירוע, אין שם.
    // האוסף הזה הוא הדרך היחידה שלו להגיד "הייתי כאן ולא הצלחתי". נכתב מ-fan-register.html
    // ע"י גולש **לא מחובר** — ולכן מאומת שדה-שדה בדיוק כמו events, ולא "כל אחד יכול לכתוב".
    //
    // ⚠️ `message` הוא שדה-טקסט חופשי הפתוח לכתיבה אנונימית — משטח-הזרקה/ספאם היחיד מסוגו
    // בפרויקט. שלוש ההגנות: תקרת 1000 תווים, `status` נעול ל-'new' (אי אפשר להיוולד "מטופל"
    // ולעקוף את תשומת-לב המנהל), ואפס קריאה פומבית. **התצוגה במרכז הניהול חייבת לברוח
    // (esc) את הטקסט** — הוא נכתב ע"י גורם לא מזוהה.
    match /helpRequests/{reqId} {
      allow read: if isAdmin();
      // update — כדי שהמנהל יסמן "טיפלתי" על הבקשה עצמה. delete נשאר חסום: פנייה של אדם
      // אמיתי לא נמחקת בלחיצה, בדיוק כמו events.
      allow update: if isAdmin();
      allow delete: if false;

      allow create: if
        request.resource.data.keys().hasOnly([
          'name', 'contact', 'message', 'source', 'device', 'lastField',
          'errCode', 'path', 'sessionId', 'memberId', 'status', 'createdAt'
        ]) &&
        request.resource.data.keys().hasAll(['contact', 'message', 'status', 'createdAt']) &&
        request.resource.data.createdAt == request.time &&
        // 'new' בלבד ביצירה — הסטטוס משתנה רק ע"י מנהל, דרך allow update למעלה
        request.resource.data.status == 'new' &&
        // ⚠️ contact הוא **חובה ולא-ריק**: פנייה בלי דרך לחזור אליה היא פנייה מבוזבזת.
        // זו בדיוק ההחלטה של המשתמש ("כן צריך") — ונאכפת כאן ולא רק בטופס, כי ולידציה
        // בצד-לקוח לבדה אינה אכיפה.
        request.resource.data.contact is string &&
        request.resource.data.contact.size() > 0 && request.resource.data.contact.size() <= 120 &&
        request.resource.data.message is string &&
        request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 1000 &&
        (!('name' in request.resource.data) || request.resource.data.name == null ||
          (request.resource.data.name is string && request.resource.data.name.size() <= 80)) &&
        // §322 — 'loginFail' נוסף: הפאנל הזה חי עכשיו גם במודאל-הכניסה ב-welcome.html, לא רק
        // בטופס ההרשמה. אוהד **שכבר רשום ומאושר** ולא מצליח להיכנס הוא מקרה גרוע יותר מנרשם
        // שנתקע — הוא כבר בפנים, ואין לו שום דרך אחרת להגיע אלינו.
        (!('source' in request.resource.data) || request.resource.data.source == null ||
          request.resource.data.source in ['stuck', 'question', 'photoFail', 'submitFail', 'loginFail']) &&
        (!('device' in request.resource.data) || request.resource.data.device == null ||
          request.resource.data.device in ['mobile', 'desktop']) &&
        (!('lastField' in request.resource.data) || request.resource.data.lastField == null ||
          (request.resource.data.lastField is string && request.resource.data.lastField.size() <= 60)) &&
        (!('errCode' in request.resource.data) || request.resource.data.errCode == null ||
          (request.resource.data.errCode is string && request.resource.data.errCode.size() <= 60)) &&
        (!('path' in request.resource.data) || request.resource.data.path == null ||
          (request.resource.data.path is string && request.resource.data.path.size() <= 200)) &&
        (!('sessionId' in request.resource.data) || request.resource.data.sessionId == null ||
          (request.resource.data.sessionId is string && request.resource.data.sessionId.size() <= 100)) &&
        (!('memberId' in request.resource.data) || request.resource.data.memberId == null ||
          (request.resource.data.memberId is string && request.resource.data.memberId.size() <= 100));
    }

    // statsDaily — אגרגציה יומית כלל-פלטפורמה (מקביל ל-businesses/{id}/statsDaily למעלה).
    // ייכתב בפועל רק ע"י ה-Worker (service-account, עוקף rules) בשלב האגרגציה העתידי.
    match /statsDaily/{dateId} {
      allow read, write: if isAdmin();
    }

    // ברירת מחדל: הכול חסום. אין match לאף collection אחר.
  }
}
