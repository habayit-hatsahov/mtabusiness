<?xml version="1.0" encoding="utf-8"?>
<!-- §518 — רקע חלון הפתיחה (android:background) – אנדרואיד 11 ומטה, ומאחורי מסך הפתיחה של 12+.
     צבע + הלוגו ממורכז ב-180×45dp, זהה לאייקון של 12+ ולאתר. היה @drawable/splash: תמונת Z שנמתחת
     על כל המסך (splash.png בצפיפויות השונות – נשארו בפרויקט, לא בשימוש). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><color android:color="@color/yz_splash_bg"/></item>
    <item android:width="180dp" android:height="45dp" android:gravity="center" android:drawable="@drawable/yz_splash_logo"/>
</layer-list>
