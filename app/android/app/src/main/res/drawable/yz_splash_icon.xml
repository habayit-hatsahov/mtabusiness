<?xml version="1.0" encoding="utf-8"?>
<!-- §518 — האייקון של מסך הפתיחה באנדרואיד 12+ (windowSplashScreenAnimatedIcon).
     המערכת מציגה אותו על משטח 288dp ומסכה אותו לעיגול בקוטר 192dp (מפרט ה-SplashScreen API, אייקון
     בלי רקע). לוגו רחב (1730:430) חייב להיכנס לעיגול: 180×45dp – הפינות ב-~93dp מהמרכז, בתוך רדיוס 96.
     ⚠️ ולכן גם האתר מציג את הלוגו ב-180px באפליקציית האנדרואיד החדשה (YZSplash/2 ב-user agent),
     אחרת הייתה קפיצת-גודל במעבר (240 באתר מול 180 כאן). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="288dp" android:height="288dp">
        <shape android:shape="rectangle"><solid android:color="@android:color/transparent"/></shape>
    </item>
    <item android:width="180dp" android:height="45dp" android:gravity="center" android:drawable="@drawable/yz_splash_logo"/>
</layer-list>
