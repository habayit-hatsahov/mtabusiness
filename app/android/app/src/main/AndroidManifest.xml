<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- §496 — App Links: yellowzone.co.il/download ו-/open (הכפתור במייל האישור, §494, והקישור
                 בפוסט) פותחים את האפליקציה ישירות. autoVerify מול /.well-known/assetlinks.json באתר,
                 שחייב לכלול את ה-SHA-256 של מפתח החתימה של Play (App integrity). המקביל ל-§495 באייפון. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="yellowzone.co.il" android:path="/download" />
                <data android:scheme="https" android:host="yellowzone.co.il" android:path="/download.html" />
                <data android:scheme="https" android:host="yellowzone.co.il" android:path="/open" />
                <data android:scheme="https" android:host="yellowzone.co.il" android:path="/open.html" />
            </intent-filter>
        </activity>

        <!-- §420יא : אייקון ההתראה הוחזר לאייקון האפליקציה, לבקשת המשתמש.
             שתי שורות ה meta data של FCM (default_notification_icon ו
             default_notification_color) הוסרו מכאן. בלעדיהן FCM נופל לאייקון
             האפליקציה, וסמסונג מציגה אותו בתוך עיגול לבן משלה. זה המצב שהיה
             לפני §420י.

             ⚠️ הקבצים עצמם נשארו בפרויקט ולא נמחקו : res/drawable *dpi/ic_stat_yz.png
             ו res/values/colors.xml. הם פשוט אינם מקושרים מכאן. להפעלה חוזרת
             צריך רק להחזיר את שתי שורות ה meta data.

             🔑 מה שנמדד בפועל על Galaxy A52s, כדי שלא נחזור על זה :
               · אייקון התראה באנדרואיד הוא מונוכרום בהגדרה. הוא קורא רק את ערוץ
                 השקיפות, ולכן לוגו צבעוני שם בלתי אפשרי.
               · שדה image של FCM אינו משנה את האייקון כלל. נבדק.
               · שדה color חסום בתקרת בהירות של One UI במצב כהה :
                     #FFCE00 יצא #906F00   ·   #FFA000 יצא #AF5F00
                     #FFF59D נדחה לצבע הרקע  ·  #FFFFFF נדחה לצבע הרקע
                 כלומר אין שום צהוב שייצא כעיגול צהוב בהיר.
               · הדרך היחידה לשליטה מלאה היא לשלוח data בלבד ולבנות את ההתראה
                 בקוד נייטיב, ⚠️ במחיר אמינות מסירה : הודעות data נשמטות במצב
                 חיסכון בסוללה ואינן מגיעות כלל אם המשתמש עצר את האפליקציה בכוח.
               · לא נבדק : איך זה נראה במצב תצוגה בהיר. ייתכן שהבעיה כולה
                 נוגעת רק למשתמשי מצב כהה. -->

        <!-- 13.10 (לגרסה 1.3) — הוחזר לבקשת רמי: Z בכחול כהה. הצבע ב-colors.xml (yz_notification). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_yz" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/yz_notification" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
